{
  "name": "milkplan",
  "version": "0.1.0",
  "description": "Review, edit, and annotate Claude Code plans in a Milkdown WYSIWYG editor before approving them",
  "license": "MIT",
  "bin": {
    "milkplan": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node dist/cli.mjs test-fire",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/plugin-highlight": "^7.22.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.4.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unrun": "^0.3.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
