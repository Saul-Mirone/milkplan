{
  "name": "@enorim/milkplan",
  "version": "0.0.4",
  "description": "Review, edit, and annotate Claude Code plans in a Milkdown WYSIWYG editor before approving them",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "hook",
    "milkdown",
    "permission-request",
    "plan",
    "wysiwyg"
  ],
  "homepage": "https://github.com/Saul-Mirone/milkplan#readme",
  "bugs": {
    "url": "https://github.com/Saul-Mirone/milkplan/issues"
  },
  "license": "MIT",
  "author": "Saul-Mirone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saul-Mirone/milkplan.git"
  },
  "bin": {
    "milkplan": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "hooks",
    ".claude-plugin/plugin.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node dist/cli.mjs test-fire",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-version.mjs && oxfmt README.md CHANGELOG.md .claude-plugin/plugin.json",
    "release:publish": "pnpm run check && changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/plugin-highlight": "^7.22.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.4.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unrun": "^0.3.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
